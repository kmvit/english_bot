# Копировать в /etc/default/english-bot-tunnel (права 600).
# Зарубежный хост, через который бот ходит в Telegram и OpenRouter.
TUNNEL_HOST=vpn.example.com
TUNNEL_USER=root
TUNNEL_PORT=22
TUNNEL_KEY=/root/.ssh/english_bot_tunnel
# Локальный конец туннеля; это же значение идёт в PROXY_URL бота.
TUNNEL_BIND=127.0.0.1:1080
