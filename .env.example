# --- Обязательные ---
TELEGRAM_TOKEN=123456:ABC-DEF
OPENROUTER_API_KEY=sk-or-v1-...
ALLOWED_USER_ID=123456789

# --- LLM (OpenAI SDK через OpenRouter) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4.1
LLM_FALLBACK_MODEL=openai/gpt-4.1-mini
# Только для reasoning-моделей (o-серия, gpt-5): low | medium | high. Пусто — не отправлять.
LLM_REASONING_EFFORT=
# Необязательная атрибуция трафика в панели OpenRouter
OPENROUTER_REFERER=
OPENROUTER_TITLE=english-teacher-bot

# --- Распознавание речи ---
# whisper — локально и бесплатно, только текст без оценки произношения
# azure   — оценка произношения по фонемам, нужны ключи ниже
SPEECH_BACKEND=whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=0
SPEECH_RECOGNITION_LANGUAGE=en-US

# --- Озвучка ответов ---
# auto — Azure при наличии ключей, иначе Piper (локально, бесплатно)
# kokoro — живее по интонации, но модель 340 МБ вместо 60 МБ у Piper
TTS_BACKEND=auto
# Голос Kokoro: af_bella, af_heart, bf_emma и ещё полсотни в одном файле
KOKORO_VOICE=af_bella
KOKORO_MODEL_DIR=data/kokoro
# Голос Piper: скачивается один раз в PIPER_MODEL_DIR при первом запуске
PIPER_VOICE=en_US-lessac-medium
PIPER_MODEL_DIR=data/voices
# Темп речи: 1.0 — как записан голос, 1.3 — медленнее (легче разобрать на слух),
# 1.6 — совсем медленно. Меньше 1.0 ускоряет.
TTS_LENGTH_SCALE=1.3
# Голос Azure, если TTS_BACKEND=azure
TTS_VOICE=en-US-JennyNeural

# --- Azure (нужен только при SPEECH_BACKEND=azure или TTS_BACKEND=azure) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Учить живой речи с матом: слова не вымарываются, а разбирается уместность.
# Само по себе крепкое слово не считается ошибкой — исправляется грамматика рядом.
TEACH_PROFANITY=false

# --- Расписание ---
# Часовой пояс ученика: «девять утра» означает девять утра у него,
# а не там, где стоит сервер.
TIMEZONE=Europe/Moscow
# День недели (0 — понедельник) и время недельной сводки.
WEEKLY_WEEKDAY=6
WEEKLY_TIME=19:00

# --- Прочее ---
DB_PATH=data/bot.db
HISTORY_LIMIT=20
MAX_VOICE_SECONDS=60
LEVEL_CHECK_EVERY=50
FFMPEG_BIN=ffmpeg
LOG_LEVEL=INFO
# Включить, если Telegram отвечает таймаутами: на части сетей IPv6 до него не проходит
TELEGRAM_FORCE_IPV4=false
# Прокси для Telegram и OpenRouter, если они недоступны напрямую.
# На сервере это локальный конец ssh-туннеля: socks5://127.0.0.1:1080
PROXY_URL=

# --- Тарифы для подсчёта стоимости (USD), если OpenRouter не вернул usage.cost ---
# По умолчанию — цены gpt-4.1; под другую модель поправить.
PRICE_INPUT_PER_MTOK=2.0
PRICE_OUTPUT_PER_MTOK=8.0
PRICE_CACHE_READ_PER_MTOK=0.5
AZURE_STT_USD_PER_HOUR=1.0
AZURE_TTS_USD_PER_1M_CHARS=16.0
